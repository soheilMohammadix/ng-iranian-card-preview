{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ng-iranian-card-preview": {
      "projectType": "library",
      "root": "projects/ng-iranian-card-preview",
      "sourceRoot": "projects/ng-iranian-card-preview/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/ng-iranian-card-preview/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ng-iranian-card-preview/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ng-iranian-card-preview/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/ng-iranian-card-preview/src/test.ts",
            "tsConfig": "projects/ng-iranian-card-preview/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "b4bca5af-c4c3-4b6b-86f0-06f8f5cebd04"
  }
}
