{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"outDir": "../../out-tsc/lib",
		"declaration": true,
		"declarationMap": true,
		"inlineSources": true,
		"types": [],
		"lib": [
			"dom",
			"es2018"
		],
		"resolveJsonModule": true,
		"esModuleInterop": true
	},
	"angularCompilerOptions": {
		"skipTemplateCodegen": true,
		"strictMetadataEmit": true,
		"enableResourceInlining": true
	},
	"include": [
		"**/*.ts"
	],
	"exclude": [
		"**/*.spec.ts"
	]
}
